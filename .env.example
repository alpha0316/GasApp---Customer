# Public values only. EXPO_PUBLIC_* is bundled into the app. Never put a secret here.
# Live:  https://gasapp.thelocalgodd.me/api/v1
# Local: http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google sign-in client IDs (public identifiers). The backend must list them in GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional map tile key for the basemap in lib/mapTiles.ts.
EXPO_PUBLIC_MAP_TILE_KEY=

# Build time only (read by app.config.ts, not bundled). Restrict the key to the Android package in Google Cloud.
# For EAS builds, set it as an EAS secret instead.
GOOGLE_MAPS_ANDROID_API_KEY=
